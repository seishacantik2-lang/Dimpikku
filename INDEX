                        </div>
                        <h3 class="font-extrabold text-brand-dark text-lg leading-snug group-hover:text-brand-orange transition">${item.name}</h3>
                        <p class="text-xs text-gray-500 font-medium mt-1">${item.desc}</p>
                    </div>

                    <div class="mt-5 pt-3 border-t border-gray-100 flex items-center justify-between">
                        <div>
                            <span class="text-[10px] text-gray-400 font-bold block">Harga</span>
                            <span class="text-lg font-black text-brand-orangeDark">Rp ${item.price.toLocaleString('id-ID')}</span>
                        </div>

                        ${qty === 0 ? `
                            <button onclick="addToCart('${item.id}')" class="bg-brand-yellow hover:bg-amber-400 text-brand-dark font-black px-4 py-2 rounded-xl text-xs flex items-center gap-1.5 transition shadow-sm">
                                <i class="fa-solid fa-plus"></i> Tambah
                            </button>
                        ` : `
                            <div class="flex items-center gap-2 bg-amber-100 p-1 rounded-xl border border-yellow-300">
                                <button onclick="updateQty('${item.id}', -1)" class="w-7 h-7 rounded-lg bg-white text-brand-dark font-black text-xs shadow hover:bg-gray-100 flex items-center justify-center">
                                    <i class="fa-solid fa-minus"></i>
                                </button>
                                <span class="font-black text-xs text-brand-dark px-1">${qty}</span>
                                <button onclick="updateQty('${item.id}', 1)" class="w-7 h-7 rounded-lg bg-brand-orange text-white font-black text-xs shadow hover:bg-brand-orangeDark flex items-center justify-center">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                        `}
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // FILTER TABS LOGIC
        function filterCategory(category) {
            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(btn => {
                btn.classList.remove('active', 'bg-brand-orange', 'text-white');
                btn.classList.add('bg-white', 'text-gray-700');
            });

            event.currentTarget.classList.remove('bg-white', 'text-gray-700');
            event.currentTarget.classList.add('active', 'bg-brand-orange', 'text-white');

            renderMenu.animate = true;
            renderMenu(category);
        }

        // CART LOGIC
        function addToCart(itemId) {
            const item = menuData.find(i => i.id === itemId);
            if (!item) return;

            if (cart[itemId]) {
                cart[itemId].qty += 1;
            } else {
                cart[itemId] = {
                    ...item,
                    qty: 1
                };
            }
            updateCartUI();
            renderMenu(getActiveCategory());
            showToast(item.name);
        }

        function updateQty(itemId, change) {
            if (!cart[itemId]) return;

            cart[itemId].qty += change;
            if (cart[itemId].qty <= 0) {
                delete cart[itemId];
            }
            updateCartUI();
            renderMenu(getActiveCategory());
        }

        function getActiveCategory() {
            const activeBtn = document.querySelector('.tab-btn.active');
            if (!activeBtn) return 'isi4';
            const text = activeBtn.textContent.trim();
            if (text.includes('Isi 4')) return 'isi4';
            if (text.includes('Isi 6')) return 'isi6';
            if (text.includes('Isi 8')) return 'isi8';
            if (text.includes('Isi 16')) return 'isi16';
            if (text.includes('Udang')) return 'special';
            if (text.includes('Frozen')) return 'frozen';
            if (text.includes('Add On')) return 'addon';
            return 'isi4';
        }

        function updateCartUI() {
            let totalItems = 0;
            let totalPrice = 0;

            Object.values(cart).forEach(item => {
                totalItems += item.qty;
                totalPrice += (item.price * item.qty);
            });

            // Update Badges
            const badge = document.getElementById('cartCountBadge');
            const mobileBadge = document.getElementById('mobileBadge');
            
            if (totalItems > 0) {
                badge.textContent = totalItems;
                badge.classList.remove('pop'); void badge.offsetWidth; badge.classList.add('pop');
                badge.classList.remove('hidden');
                mobileBadge.textContent = totalItems;
                document.getElementById('floatingCartBar').classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
                document.getElementById('floatingCartBar').classList.add('hidden');
            }

            // Update Price Displays
            document.getElementById('mobileTotalPrice').textContent = `Rp ${totalPrice.toLocaleString('id-ID')}`;
            document.getElementById('qrisTotal').textContent = `Rp ${totalPrice.toLocaleString('id-ID')}`;
            document.getElementById('cartTotalPrice').textContent = `Rp ${totalPrice.toLocaleString('id-ID')}`;

            // Render Cart Modal Items
            renderCartModalItems();
        }

        function renderCartModalItems() {
            const container = document.getElementById('cartItemsContainer');
            const emptyState = document.getElementById('emptyCartState');
            const orderForm = document.getElementById('orderForm');
            const btnSendWA = document.getElementById('btnSendWA');

            const cartKeys = Object.keys(cart);
            container.innerHTML = '';

            if (cartKeys.length === 0) {
                emptyState.classList.remove('hidden');
                orderForm.classList.add('hidden');
                btnSendWA.classList.add('opacity-50', 'pointer-events-none');
                return;
            }

            emptyState.classList.add('hidden');
            orderForm.classList.remove('hidden');
            btnSendWA.classList.remove('opacity-50', 'pointer-events-none');

            cartKeys.forEach(key => {
                const item = cart[key];
                const row = document.createElement('div');
                row.className = "flex items-center justify-between p-3 bg-gray-50 rounded-2xl border border-gray-100";
                
                row.innerHTML = `
                    <div class="flex-1 pr-2">
                        <p class="font-extrabold text-xs text-brand-dark">${item.name}</p>
                        <p class="text-[11px] text-brand-orangeDark font-bold">@ Rp ${item.price.toLocaleString('id-ID')}</p>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-2 bg-white px-2 py-1 rounded-xl border border-gray-200">
                            <button onclick="updateQty('${item.id}', -1)" class="text-gray-600 hover:text-red-500 font-bold px-1 text-xs"> - </button>
                            <span class="font-bold text-xs text-brand-dark">${item.qty}</span>
                            <button onclick="updateQty('${item.id}', 1)" class="text-gray-600 hover:text-emerald-600 font-bold px-1 text-xs"> + </button>
                        </div>
                        <span class="font-black text-xs text-gray-800 w-16 text-right">Rp ${(item.price * item.qty).toLocaleString('id-ID')}</span>
                    </div>
                `;
                container.appendChild(row);
            });
        }

        function onPayChange() {
            const m = document.querySelector('input[name="payMethod"]:checked').value;
            document.getElementById('qrisPanel').classList.toggle('hidden', m !== 'QRIS');
            document.getElementById('cashPanel').classList.toggle('hidden', m !== 'Cash');
            document.getElementById('timeBox').classList.remove('hidden');
        }

        function onDeliveryChange() {
            const take = document.getElementById('deliveryType').value.startsWith('Takeaway');
            document.getElementById('timeLabel').textContent = take ? 'Jam Ambil di Toko *' : 'Jam Pengantaran *';
        }

        function toggleCartModal() {
            const modal = document.getElementById('cartModal');
            modal.classList.toggle('hidden');
            if (!modal.classList.contains('hidden')) warmUp();
        }

        // =====================================================
        // INTEGRASI GOOGLE SHEET (tab "Website")
        // Tempel URL Web App dari Google Apps Script di bawah ini.
        // (Apps Script > Deploy > New deployment > Web app > salin URL yang berakhiran /exec)
        // =====================================================
        const SHEET_WEBHOOK_URL = 'https://script.google.com/macros/s/AKfycbyQfThlSw7vtPCbHox1o9xJLUHSf1B5WbfPK6i9WIhlHlb3LFoautyLEsfAOriya4fR/exec';

        const CATEGORY_LABELS = {
            isi4: 'Dimsum Isi 4', isi6: 'Dimsum Isi 6', isi8: 'Dimsum Isi 8', isi16: 'Dimsum Isi 16',
            special: 'Udang & Goreng Keju', frozen: 'Dimsum Frozen', addon: 'Add On / Pelengkap'
        };

        // "Dimsum Mentai (Isi 4)" -> "Dimsum Mentai" (semua ukuran digabung untuk ranking varian)
        function variantOf(name) {
            return name.replace(/\s*\(Isi \d+\)\s*$/, '');
        }

        function makeOrderId() {
            const d = new Date(), p = n => String(n).padStart(2, '0');
            return 'DMP-' + String(d.getFullYear()).slice(2) + p(d.getMonth() + 1) + p(d.getDate()) +
                '-' + p(d.getHours()) + p(d.getMinutes()) + p(d.getSeconds()) +
                '-' + Math.random().toString(36).slice(2, 5).toUpperCase();
        }

        // Antrean kirim: data disimpan dulu, lalu dikirim berurutan. Kalau koneksi putus,
        // data tetap tersimpan di browser dan dikirim ulang saat halaman dibuka / online lagi.
        const PENDING_KEY = 'dimpik_pending_posts';
        function loadPending() {
            try { return JSON.parse(localStorage.getItem(PENDING_KEY) || '[]'); } catch (e) { return []; }
        }
        function savePending() {
            try { localStorage.setItem(PENDING_KEY, JSON.stringify(pendingQueue.slice(-30))); } catch (e) {}
        }
        let pendingQueue = loadPending();
        let flushing = false;

        function sendToSheet(data) {
            if (!SHEET_WEBHOOK_URL) {
                console.warn('[Dimpik] SHEET_WEBHOOK_URL belum diisi, data tidak dikirim ke Google Sheet.');
                return;
            }
            pendingQueue.push(data);
            savePending();
            flushPending();
        }

        async function flushPending() {
            if (flushing || !SHEET_WEBHOOK_URL) return;
            flushing = true;
            try {
                while (pendingQueue.length) {
                    await fetch(SHEET_WEBHOOK_URL, {
                        method: 'POST',
                        mode: 'no-cors',
                        keepalive: true,
                        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                        body: JSON.stringify(pendingQueue[0])
                    });
                    pendingQueue.shift();
                    savePending();
                }
            } catch (e) {
                // offline: biarkan di antrean, dicoba lagi nanti
            } finally {
                flushing = false;
            }
        }
        window.addEventListener('online', flushPending);

        // ---------- REVIEW SETELAH PESANAN ----------
        let lastOrder = null;
        let pendingOrder = null;
        let reviewRating = 0;
        const RATING_TEXT = ['', 'Kurang banget 😞', 'Kurang puas 😕', 'Lumayan 🙂', 'Bagus! 😋', 'Mantap banget! 🤩'];

        function openReviewModal() {
            reviewRating = 0;
            setRating(0);
            document.querySelectorAll('#reviewTags .tag-chip').forEach(b => paintTag(b, false));
            document.getElementById('reviewText').value = '';
            document.getElementById('reviewError').classList.add('hidden');
            document.getElementById('reviewBody').classList.remove('hidden');
            document.getElementById('reviewThanks').classList.add('hidden');
            document.getElementById('reviewName').textContent = lastOrder && lastOrder.name ? lastOrder.name : 'kak';
            document.getElementById('reviewOrderId').textContent = lastOrder ? lastOrder.id : '';
            document.getElementById('reviewModal').classList.remove('hidden');
        }

        function closeReviewModal() {
            document.getElementById('reviewModal').classList.add('hidden');
        }

        function setRating(n) {
            reviewRating = n;
            document.querySelectorAll('#reviewStars .star-btn').forEach((btn, i) => {
                const on = i < n;
                btn.classList.toggle('text-amber-400', on);
                btn.classList.toggle('text-gray-300', !on);
            });
            document.getElementById('ratingLabel').textContent = RATING_TEXT[n] || '';
            if (n) document.getElementById('reviewError').classList.add('hidden');
        }

        function paintTag(btn, on) {
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            btn.classList.toggle('bg-brand-orange', on);
            btn.classList.toggle('text-white', on);
            btn.classList.toggle('border-brand-orange', on);
            btn.classList.toggle('bg-white', !on);
            btn.classList.toggle('text-gray-700', !on);
            btn.classList.toggle('border-yellow-300', !on);
        }

        function toggleTag(btn) {
            paintTag(btn, btn.getAttribute('aria-pressed') !== 'true');
        }

        // ---------- JACKPOT ----------
        // Nomor urut pesanan = jumlah pesanan unik di Google Sheet. Pola diulang tiap 100.
        const JACKPOT_PRIZES = {
            15: 'Chili Oil',
            45: 'Dimsum Ori isi 2',
            65: 'Chili Oil',
            80: 'Dimsum Ori isi 4',
            95: 'Chili Oil',
            100: 'Chili Oil + Dimsum Ori isi 4 (gratis)'
        };
        function jackpotFor(n) {
            if (!n) return '';
            const k = n % 100 === 0 ? 100 : n % 100;   // 115 -> 15, 200 -> 100
            return JACKPOT_PRIZES[k] || '';
        }

        // Bangunkan Apps Script lebih awal (cold start bisa 3-6 detik) supaya kirim pesanan terasa cepat
        let warmed = 0;
        function warmUp() {
            if (!SHEET_WEBHOOK_URL || Date.now() - warmed < 4 * 60 * 1000) return;
            warmed = Date.now();
            try { fetch(SHEET_WEBHOOK_URL + '?ping=1', { mode: 'no-cors', keepalive: true }).catch(() => {}); } catch (e) {}
        }

        // Kirim pesanan & baca balasan (nomor urut). Satu kali coba (maks 8 dtk); server menolak data dobel,
        // kalau gagal pesanan masuk antrean dan dikirim ulang otomatis.
        async function postOrderForResult(data) {
            try {
                const ctrl = new AbortController();
                const timer = setTimeout(() => ctrl.abort(), 8000);
                const r = await fetch(SHEET_WEBHOOK_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(data),
                    signal: ctrl.signal
                });
                clearTimeout(timer);
                const j = await r.json();
                if (j && j.ok) return j;
            } catch (e) { /* jatuh ke antrean */ }
            return null;
        }

        function buildWaUrl(o, orderNo, hadiah) {
            let m = o.message;
            if (orderNo) m += `🔢 *Urutan Pesanan:* ke-${orderNo}\n`;
            if (!orderNo) m += `🎰 *Status Jackpot:* akan dicek admin\n\n`;
            else if (hadiah) m += `🎰 *STATUS JACKPOT:* 🎉 YA! Hadiah: *${hadiah}*\n\n`;
            else m += `🎰 *Status Jackpot:* belum kena jackpot\n\n`;
            m += `Mohon konfirmasi pesanan dan info pembayarannya ya kak. Terima kasih! 😋✨`;
            return `https://api.whatsapp.com/send/?phone=6287743146842&text=${encodeURIComponent(m)}&type=phone_number&app_absent=0`;
        }

        let nextWaUrl = '';
        function goWhatsApp(url) { if (url) window.location.href = url; }
        function showJackpot(name, hadiah) {
            document.getElementById('jpName').textContent = name || 'kak';
            document.getElementById('jpPrize').textContent = hadiah;
            document.getElementById('jackpotModal').classList.remove('hidden');
            const em = ['🎉', '✨', '🥟', '🎊', '⭐'];
            for (let i = 0; i < 24; i++) {
                const s = document.createElement('span');
                s.className = 'jp-confetti';
                s.textContent = em[i % em.length];
                s.style.left = (Math.random() * 100) + 'vw';
                s.style.animationDuration = (2.4 + Math.random() * 2.2) + 's';
                s.style.animationDelay = (Math.random() * 0.8) + 's';
                document.body.appendChild(s);
                setTimeout(() => s.remove(), 6000);
            }
        }
        function closeJackpot() {
            document.getElementById('jackpotModal').classList.add('hidden');
            const u = nextWaUrl; nextWaUrl = '';
            goWhatsApp(u);   // dari klik tombol, jadi tidak diblokir browser
        }

        let submitting = false;
        async function submitReview() {
            if (!pendingOrder) { closeReviewModal(); return; }
            if (!reviewRating) {
                const err = document.getElementById('reviewError');
                err.textContent = 'Isi bintang dulu ya sebelum lanjut ke WhatsApp.';
                err.classList.remove('hidden');
                return;
            }
            if (submitting) return;
            submitting = true;
            const o = pendingOrder;
            const tags = Array.from(document.querySelectorAll('#reviewTags .tag-chip[aria-pressed="true"]')).map(b => b.dataset.tag);
            const payload = Object.assign({}, o.payload, {
                rating: reviewRating,
                tags: tags,
                komentar: document.getElementById('reviewText').value.trim()
            });

            const btn = document.querySelector('#reviewBody button[onclick="submitReview()"]');
            const btnHtml = btn ? btn.innerHTML : '';
            if (btn) { btn.disabled = true; btn.textContent = 'Memproses pesanan...'; }

            const res = await postOrderForResult(payload);
            if (!res) sendToSheet(payload);   // gagal: simpan di antrean, dikirim ulang otomatis

            const orderNo = res ? Number(res.orderNo) || 0 : 0;
            const hadiah = jackpotFor(orderNo);
            const waUrl = buildWaUrl(o, orderNo, hadiah);

            pendingOrder = null;
            submitting = false;
            if (btn) { btn.disabled = false; btn.innerHTML = btnHtml; }

            finishOrder();
            if (hadiah) {
                // Jackpot tampil dulu; WhatsApp dibuka setelah tombol "Lanjut ke WhatsApp" ditekan
                nextWaUrl = waUrl;
                closeReviewModal();
                showJackpot(o.name, hadiah);
            } else {
                document.getElementById('reviewBody').classList.add('hidden');
                document.getElementById('reviewThanks').classList.remove('hidden');
                setTimeout(() => { closeReviewModal(); goWhatsApp(waUrl); }, 900);
            }
        }

        // Dipanggil setelah ulasan terkirim: kosongkan keranjang & form
        function finishOrder() {
            cart = {};
            updateCartUI();
            renderMenu(getActiveCategory());

            document.getElementById('custNotes').value = '';
            document.getElementById('pickupTime').value = '';
            document.querySelectorAll('input[name="payMethod"]').forEach(r => r.checked = false);
            ['qrisPanel', 'cashPanel', 'timeBox'].forEach(id => document.getElementById(id).classList.add('hidden'));
            document.getElementById('deliveryType').selectedIndex = 0;
            onDeliveryChange();

            document.getElementById('cartModal').classList.add('hidden');
        }

        // SEND WHATSAPP FORMATTED MESSAGE
        function sendOrderToWhatsApp() {
            warmUp();
            const custName = document.getElementById('custName').value.trim();
            const deliveryType = document.getElementById('deliveryType').value;
            const custNotes = document.getElementById('custNotes').value.trim();

            if (!custName) {
                alert('Silakan isi Nama Pemesan terlebih dahulu!');
                document.getElementById('custName').focus();
                return;
            }

            const cartKeys = Object.keys(cart);
            if (cartKeys.length === 0) {
                alert('Keranjang belanja kamu masih kosong!');
                return;
            }

            const pay = document.querySelector('input[name="payMethod"]:checked');
            if (!pay) { alert('Pilih metode pembayaran: QRIS atau Cash.'); return; }
            const pickup = document.getElementById('pickupTime').value;
            if (!pickup) { alert('Pilih jam pengambilan pesanan.'); return; }
            if (pickup < '11:00' || pickup > '21:00') { alert('Jam harus antara 11.00 - 21.00 WIB.'); return; }
            const isTake = deliveryType.startsWith('Takeaway');
            const orderId = makeOrderId();

            let message = `Halo *DIMPIK*! Saya mau pesan Dimsum:\n\n`;
            message += `🧾 *No. Pesanan:* ${orderId}\n`;
            message += `👤 *Nama Pemesan:* ${custName}\n`;
            message += `🛵 *Metode:* ${deliveryType}\n`;
            message += `💳 *Pembayaran:* ${pay.value === 'QRIS' ? 'QRIS (bukti bayar menyusul)' : 'Cash (bayar langsung)'}\n`;
            message += `⏰ *Jam ${isTake ? 'Ambil' : 'Antar'}:* ${pickup} WIB\n`;
            if (custNotes) {
                message += `📝 *Catatan:* ${custNotes}\n`;
            }
            message += `\n-------------------------------\n*DETAIL PESANAN:*\n`;

            let totalPrice = 0;
            cartKeys.forEach(key => {
                const item = cart[key];
                const subtotal = item.price * item.qty;
                totalPrice += subtotal;
                message += `• ${item.name} (x${item.qty}) = Rp ${subtotal.toLocaleString('id-ID')}\n`;
            });

            message += `-------------------------------\n`;
            message += `💰 *TOTAL PEMBAYARAN: Rp ${totalPrice.toLocaleString('id-ID')}*\n\n`;

            // Data pesanan ditahan dulu; baru dikirim ke Google Sheet setelah ulasan diisi
            const orderPayload = {
                action: 'order',
                orderId: orderId,
                nama: custName,
                metode: deliveryType,
                pembayaran: pay.value,
                jam: pickup,
                catatan: custNotes,
                items: cartKeys.map(k => {
                    const it = cart[k];
                    return {
                        menu: it.name,
                        varian: variantOf(it.name),
                        kategori: CATEGORY_LABELS[it.category] || it.category,
                        qty: it.qty,
                        harga: it.price
                    };
                })
            };

            // Link WhatsApp dibuat setelah nomor urut & status jackpot diketahui (lihat buildWaUrl)
            pendingOrder = { id: orderId, name: custName, payload: orderPayload, message: message };
            lastOrder = { id: orderId, name: custName };
            openReviewModal();
        }

        function showToast(name) {
            const t = document.createElement('div');
            t.className = 'toast bg-brand-dark text-white text-xs font-bold px-4 py-3 rounded-2xl shadow-xl flex items-center gap-2 border-l-4 border-brand-yellow';
            t.innerHTML = '<i class="fa-solid fa-circle-check text-brand-yellow"></i>' + name + ' masuk keranjang';
            document.getElementById('toast').appendChild(t);
            setTimeout(() => t.remove(), 2300);
        }

        // SCROLL EFFECTS: progress bar, navbar shrink, reveal
        const bar = document.getElementById('progress'), nav = document.querySelector('nav');
        addEventListener('scroll', () => {
            const h = document.documentElement;
            bar.style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight) * 100) + '%';
            nav.classList.toggle('scrolled', h.scrollTop > 20);
        }, { passive: true });
        const io = new IntersectionObserver(es => es.forEach(e => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { threshold: 0.15 });
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));

        // 3D TILT on hero poster (desktop only)
        const tilt = document.getElementById('tilt');
        if (tilt && matchMedia('(hover:hover)').matches) {
            const w = tilt.parentElement.parentElement;
            w.addEventListener('mousemove', e => {
                const r = w.getBoundingClientRect();
                const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
                tilt.style.transform = `perspective(900px) rotateY(${x * 14}deg) rotateX(${-y * 14}deg)`;
            });
            w.addEventListener('mouseleave', () => tilt.style.transform = '');
        }

        // INITIALIZE APP
        window.onload = function() {
            renderMenu.animate = true;
            renderMenu('isi4');
            flushPending();
            warmUp();
        }
    </script>
</body>
</html>
